{
  "manifest_version": 3,
  "name": "IA Chat Extension",
  "version": "1.0",
  "description": "Sélectionner du texte et le coller dans un chat IA pour obtenir une réponse.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
